<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#F0EAE2"/>
            <corners android:radius="16dp"/>
            <stroke android:width="1dp" android:color="#DCD2C7"/>
            <padding android:left="18dp" android:top="11dp" android:right="18dp" android:bottom="11dp"/>
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#F7F4F0"/>
            <corners android:radius="16dp"/>
            <stroke android:width="1dp" android:color="#DAD0C7"/>
            <padding android:left="18dp" android:top="11dp" android:right="18dp" android:bottom="11dp"/>
        </shape>
    </item>
</selector>
