{
  "expo": {
    "name": "Respect",
    "slug": "respect",
    "description": "A private operating system for keeping your own word.",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "respect",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F5F3EE",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.respect.app"
    },
    "android": {
      "package": "com.respect.app",
      "versionCode": 3,
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "backgroundColor": "#F5F3EE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-system-ui",
      "expo-status-bar",
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a"
            ],
            "enableBundleCompression": true,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "networkInspector": false,
            "useLegacyPackaging": true
          }
        }
      ],
      "./plugins/with-android-size-optimizations"
    ],
    "extra": {
      "eas": {
        "projectId": "a152e911-c424-489d-a5f7-a1872c698dad"
      }
    }
  }
}
